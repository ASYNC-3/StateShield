# Groq API Configuration for Tier-2 LLM Judge
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Local Ollama Instance
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Guardrail & Proxy Settings
BACKEND_PORT=8000
FRONTEND_PORT=8501
TIER1_SIMILARITY_BLOCK_THRESHOLD=0.85
TIER1_SIMILARITY_ESCALATE_THRESHOLD=0.55
